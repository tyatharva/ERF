&NOAHLSM_OFFLINE

! Noah-MP driver namelist for the ChannelIslands hindcast (Jan 9-10, 2023).
! Read by the ERF-coupled Noah-MP at init (NoahmpReadNamelistMod).
!
! ERF_SETUP_FILE_01 must point at the real.exe output staged in the run
! directory (see wps/ pipeline). CROP/IRRIGATION are OFF and the runoff
! options are the standard 3/3, so the Noah-MP-specific optional geog bundle
! (crops, groundwater MMF, soilgrids) is NOT required.

 ERF_SETUP_FILE_01 = "wrfinput_d01"

 START_YEAR  = 2023
 START_MONTH = 01
 START_DAY   = 09
 START_HOUR  = 00
 START_MIN   = 00

 KDAY = 1
 SPINUP_LOOPS = 0

 DYNAMIC_VEG_OPTION                = 4
 CANOPY_STOMATAL_RESISTANCE_OPTION = 1
 BTR_OPTION                        = 1
 SURFACE_RUNOFF_OPTION             = 3
 SUBSURFACE_RUNOFF_OPTION          = 3
 DVIC_INFILTRATION_OPTION          = 1
 SURFACE_DRAG_OPTION               = 1
 FROZEN_SOIL_OPTION                = 1
 SUPERCOOLED_WATER_OPTION          = 1
 RADIATIVE_TRANSFER_OPTION         = 3
 SNOW_ALBEDO_OPTION                = 1
 PCP_PARTITION_OPTION              = 1
 SNOW_THERMAL_CONDUCTIVITY         = 1
 TBOT_OPTION                       = 2
 TEMP_TIME_SCHEME_OPTION           = 1
 GLACIER_OPTION                    = 1
 SURFACE_RESISTANCE_OPTION         = 1
 SOIL_DATA_OPTION                  = 1
 PEDOTRANSFER_OPTION               = 1
 CROP_OPTION                       = 0
 IRRIGATION_OPTION                 = 0
 IRRIGATION_METHOD                 = 0
 TILE_DRAINAGE_OPTION              = 0

 ! Noah-MP is advanced by ERF each LSM step; these control internal cadence.
 FORCING_TIMESTEP = 3600
 NOAH_TIMESTEP    = 3600
 OUTPUT_TIMESTEP  = 3600

 SPLIT_OUTPUT_COUNT = 24
 SKIP_FIRST_OUTPUT = .false.
 RESTART_FREQUENCY_HOURS = 24

 NSNOW = 4
 NSOIL = 4

 soil_thick_input(1) = 0.10
 soil_thick_input(2) = 0.30
 soil_thick_input(3) = 0.60
 soil_thick_input(4) = 1.00

 ! Reference height of the lowest atmospheric forcing level [m].
 ! ERF's first cell center is ~12.5 m over flat ground (dz1 = 25 m).
 ZLVL = 12.5

 SF_URBAN_PHYSICS = 0
 USE_WUDAPT_LCZ = 0

/
