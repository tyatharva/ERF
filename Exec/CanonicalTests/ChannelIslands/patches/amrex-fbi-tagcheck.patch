+
 namespace amrex {
 
 template <class FAB>
@@ -496,9 +499,20 @@ auto FabArray<FAB>::FB_get_local_copy_tag_vector (const FB& TheFB)
 
     using TagType = Array4CopyTag<value_type>;
 
+    // ERF DIAGNOSTIC (UPSTREAM_ISSUES 29k). This cache stores raw fab pointers for
+    // the lifetime of the FabArray. On a cache HIT, rebuild the tags from the
+    // CURRENT fabs and compare against what the device buffer actually holds. The
+    // two failure modes item 29 has to distinguish are:
+    //   device == cached but != fresh  -> cached tags are STALE (fabs moved)
+    //   device != cached               -> the device buffer was SCRIBBLED by
+    //                                     someone who was handed its arena block
+    // Enabled by AMREX_ERF_TAGCHECK; prints only on mismatch, so output is sparse.
+    static const bool erf_tagcheck = (std::getenv("AMREX_ERF_TAGCHECK") != nullptr);
+
     TagVector<TagType>* tv;
-    if (auto it = m_fb_local_copy_handler.find(TheFB.m_id);
-        it != m_fb_local_copy_handler.end())
+    auto it = m_fb_local_copy_handler.find(TheFB.m_id);
+    const bool erf_hit = (it != m_fb_local_copy_handler.end());
+    if (erf_hit && !erf_tagcheck)
     {
         tv = it->second.get();
     } else {
@@ -521,9 +535,42 @@ auto FabArray<FAB>::FB_get_local_copy_tag_vector (const FB& TheFB)
                          .offset = (tag.sbox.smallEnd()-tag.dbox.smallEnd()).dim3()});
         }
 
