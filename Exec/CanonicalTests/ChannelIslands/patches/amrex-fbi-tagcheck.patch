+        if (erf_hit) {
+            tv = it->second.get();
+            const std::size_t nb = std::size_t(tv->ntags)*sizeof(TagType);
+            Vector<char> dev(nb);
+            Gpu::dtoh_memcpy(dev.data(), tv->d_tags, nb);
+            if (int(loc_copy_tags.size()) != tv->ntags ||
+                std::memcmp(dev.data(), loc_copy_tags.data(), nb) != 0)
+            {
+                auto const* dv = reinterpret_cast<TagType const*>(dev.data());
+                for (int i = 0; i < tv->ntags && i < int(loc_copy_tags.size()); ++i) {
+                    if (std::memcmp(dv+i, loc_copy_tags.data()+i, sizeof(TagType)) != 0) {
+                        auto const* db = reinterpret_cast<unsigned char const*>(dv+i);
+                        auto const* fb = reinterpret_cast<unsigned char const*>(loc_copy_tags.data()+i);
+                        std::size_t off = 0;
+                        while (off < sizeof(TagType) && db[off] == fb[off]) { ++off; }
+                        char line[512];
+                        std::snprintf(line, sizeof(line),
