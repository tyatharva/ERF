! WPS namelist for the ChannelIslands NOAHMP static/init file (wrfinput_d01)
!
! Projection matches the erftools/ERF LCC for ERA5 area 36.0,-123.25,31.25,-115.25:
!   truelat1/2 = 32.041667 / 35.208333, stand_lon = -119.25
! ref_lat/ref_lon = ERF domain center (lat/lon of prob box midpoint,
! LCC x=-3790.23 y=2889.69):  33.651056, -119.290876
!
! KNOWN APPROXIMATION: WPS uses a spherical earth (R=6370 km); ERF/erftools
! use WGS84. Position mismatch is O(100-300 m) across the 384 km domain --
! negligible against the 30-arcsec (~900 m) soil/vegetation source data this
! file exists to provide.
!
! e_we/e_sn are STAGGERED dims = cells+1 (384x192 cells @ 1000 m).

&share
 wrf_core = 'ARW',
 max_dom  = 1,
 ! Set to the same window you give erftools (only the IC time is actually
 ! needed for wrfinput; keep a single time to make real.exe fast):
 start_date = 'YYYY-MM-DD_HH:00:00',
 end_date   = 'YYYY-MM-DD_HH:00:00',
 interval_seconds = 10800,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we   = 385,
 e_sn   = 193,
 geog_data_res = 'modis_lakes+30s',
 dx = 1000.0,
 dy = 1000.0,
 map_proj  = 'lambert',
 ref_lat   =  33.651056,
 ref_lon   = -119.290876,
 truelat1  =  32.041667,
 truelat2  =  35.208333,
 stand_lon = -119.250000,
 geog_data_path = '/app/ERF/wps_geog',
/

&ungrib
 out_format = 'WPS',
 prefix = 'ERA5',
/

&metgrid
 fg_name = 'ERA5',
 io_form_metgrid = 2,
/
